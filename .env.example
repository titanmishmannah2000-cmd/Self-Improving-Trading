# ─────────────────────────────────────────────────────────────────────────────
# HERMES TRADING — ENVIRONMENT VARIABLES TEMPLATE (single source of truth)
# ─────────────────────────────────────────────────────────────────────────────
# This file is COMMITTED (placeholders only) so every key the system reads is
# documented in ONE place. Copy it to `.env` and fill in real values:
#
#     cp .env.example .env
#     # then edit .env with your real keys
#
# `.env` is git-ignored (never committed) — it holds the REAL secrets.
# Code reads both via load_dotenv() (hermes_core/env.py), so local runs and
# Railway deploys pull from the same file.
#
# DEPLOY: at deploy time, ingest this same file into Railway's vault once:
#     railway variables --from .env
# (Railway then holds the encrypted copies; the file stays local/git-ignored.
#  You set keys ONCE, here — never twice.)
# ─────────────────────────────────────────────────────────────────────────────

# ── Price feed backend selection ──────────────────────────────────────────────
# "aggregate" (default, multi-source real quotes) | "yfinance" | "http"
PRICE_BACKEND=aggregate

# ── Hermes Price Aggregator sources (backend=aggregate) ────────────────────────
# Alpha Vantage — FX cross-check (free tier, ~15min delayed, rate-limited)
ALPHA_VANTAGE_KEY=
# metals.dev — XAU/USD + XAG/USD (your subscription; covers BOTH gold + silver)
METALS_API_KEY=

# ── httpx REST backend (backend=http, opt-in) ─────────────────────────────────
PRICE_API_URL=
PRICE_API_KEY=

# ── websockets stream backend (opt-in) ────────────────────────────────────────
PRICE_WS_URL=
PRICE_WS_API_KEY=

# ── LLM reflection + chart vision ─────────────────────────────────────────────
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
# Optional model overrides:
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_MODEL=llama-3.1-8b-instant          # L2 text consensus (not chart)
# DEEPSEEK_MODEL=deepseek-v4-pro
# CHART_GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct  # chart vision fallback

# ── Discord alerts (stdlib webhook POST, fail-soft) ────────────────────────────
DISCORD_ALERTS_WEBHOOK=
DISCORD_REFLECTIONS_WEBHOOK=
DISCORD_DAILY_WEBHOOK=

# ── Runtime / deploy ──────────────────────────────────────────────────────────
HERMES_BOT_NAME=forex
# Persistent state root (Railway: /data). Local default = repo root.
# Canonical layout: {HERMES_STATE_ROOT}/{bot}/state/  e.g. /data/crypto/state/
# Do NOT write runtime state under bots/crypto/state/ (image seeds only).
HERMES_STATE_ROOT=
DASHBOARD_API_URL=
# Comma list of bots this dashboard instance serves. Empty = forex,gold,crypto.
# BTC/USDT Railway project: DASHBOARD_BOTS=crypto
DASHBOARD_BOTS=
DASHBOARD_TITLE=
# Shared secret between bots (price/trade pushers) and the dashboard ingest API.
# Must be IDENTICAL on both sides. Empty -> dashboard rejects all ingests. [L64]
INGEST_TOKEN=
# Poll interval between cycles, seconds (loop is poll-based)
HERMES_CYCLE_SECONDS=60

# ═══════════════════════════════════════════════════════════════════════════════
# PROFITABILITY PATH Phase 0 FREEZE (Aug–Dec 2026) — Railway checklist
# ═══════════════════════════════════════════════════════════════════════════════
# Target: only BOOK_RISK among HIF flags. Prove edge before re-enabling others.
# After editing Railway vars: restart forex + gold services; then:
#   uv run python -m tools.health_check --bot gold --with-freeze
#   uv run python -m tools.health_check --bot forex --with-freeze
#   uv run python -m tools.scorecard --bot gold --freeze-check --gate
# Gate: focus-pair prices sane ≥24h (XAU not ~1.1); heartbeat not degraded.
# Phase unlock order: Phase1 prove → SOFT_WEIGHTS (Bayesian) → REFLECT canary
#   → GP_PROMOTE per green pair → micro-live. Do NOT flip multiple HIF at once.
# Deploy stage for reflection YAML writes (prove|canary|full). Soak = prove.
REFLECT_DEPLOY_STAGE=prove
# Scorecard / promote round-trip cost. For BTC use CostModel env (BTC_*_FEE_PCT);
# SCORECARD_COST_PCT remains the FX/gold flat fallback when CostModel N/A.
SCORECARD_COST_PCT=0.05
# GP promote gate cost haircut (Phase 4). Empty → CostModel / SCORECARD.
# Prefer setting explicitly when enabling GP_PROMOTE on FX/gold.
GP_PROMOTE_COST_PCT=0.05
# Micro-live size scale (Phase 5). 0.25 = 25% intended risk.
MICRO_LIVE_SIZE_MULT=0.25
# Set MICRO_LIVE=1 only after Phase 1–4 exit gates (one pair).
MICRO_LIVE=0

# ── HIF Phase-1 probe sizing ──────────────────────────────────────────────────
# "1" = open at 25% size when cortex has <5 closed outcomes for (pair, entry_type).
# "0" / unset = full size always (legacy behavior). Never blocks trades.
# Rollback: set PROBE_SIZING=0 and restart bots.
# Phase 0: MUST stay 0.
PROBE_SIZING=0

# ── Crisis soft recommend (wired; soak-dormant) ────────────────────────────────
# "1" = on entry, widen stop toward nearest non-novel crisis fingerprint when
#       R:R still passes. Adverse closes still append lived crises regardless.
# "0" / unset = stamp-free path (default soak). Phase 0: MUST stay 0.
CRISIS_RECOMMEND=0

# ── Ops self-audit cadence (runner) ───────────────────────────────────────────
# Write {bot}/state/self_audit.json every N cycles (60 ≈ hourly at 60s cadence).
# "0" = disable periodic runner audits (cron/self_audit.py still works).
SELF_AUDIT_EVERY_CYCLES=60

# ── HIF Phase-2 soft expert weights ───────────────────────────────────────────
# "1" = Bayesian Beta posterior size weights (min_n passthrough, retire on decay).
# Enable ONLY after Phase 1 exit gate + expert_weights Bayesian rewrite.
# "0" / unset = hard policy_suppress skips. Phase 0: MUST stay 0.
SOFT_WEIGHTS=0

# ── HIF Phase-3 soft regime size multiplier ───────────────────────────────────
# "1" = scale size by trend/range + short direction (never blocks).
# "0" / unset = no extra regime mult (legacy). Phase 0: MUST stay 0.
REGIME_SIZING=0

# ── HIF Phase-4 skip + GP-shadow reflection fuel ──────────────────────────────
# "1" = log shadow hypotheses from skips/gp_shadow when pairs are quiet;
#       also attach skip context to trade-based reflection. Never auto-deploys.
# "0" / unset = close-only reflection. Phase 0: MUST stay 0 (no shadow learning fuel).
# BTC soak: may set SKIP_SHADOW_REFLECT=1 for context-only fuel; keep SKIP_SHADOW_PROMOTE=0.
SKIP_SHADOW_REFLECT=0

# ── HIF Phase-5 Bayesian fractional Kelly ─────────────────────────────────────
# "1" = scale size by quarter-Kelly from cortex Beta WR + payoff odds.
# No evidence → passthrough. Phase 0: MUST stay 0.
KELLY_SIZING=0

# ── HIF Layer B entry ranking ─────────────────────────────────────────────────
# "1" = when traditional and GP both fire, open the higher expected-edge score.
# Still opens if only one candidate. Phase 0–4: MUST stay 0 (no beauty contest).
ENTRY_RANKING=0

# ── HIF exit intelligence ─────────────────────────────────────────────────────
# "1" = stamp trail / BE / partial knobs from cortex per pair (same fills).
# Thin evidence → passthrough. Phase 0: MUST stay 0.
EXIT_INTEL=0

# ── HIF skip-shadow promote (gated) ───────────────────────────────────────────
# "1" = auto-backtest deployable skip_shadow_proposed (e.g. RR TP fix).
# Never blind — backtest must pass; REFLECT_AUTO_DEPLOY gates YAML write.
# Phase 0: MUST stay 0.
SKIP_SHADOW_PROMOTE=0

# ── Reflection auto-deploy ────────────────────────────────────────────────────
# "0" = stop at approved_pending_deploy (safe default for soak). Phase 0–2: MUST stay 0.
# "1" = write YAML after backtest pass + verifier (only at canary/full stage).
REFLECT_AUTO_DEPLOY=0
# Cap concurrent reflection daemon threads per process (default 2).
REFLECT_MAX_THREADS=2

# ── HIF book-level risk ───────────────────────────────────────────────────────
# "1" = soft-cap total open size + tilt new size by posterior edge vs book.
# Phase 0 FREEZE: this is the ONLY HIF flag that should be ON.
BOOK_RISK=1

# ── HIF MFE/MAE peak tracking ─────────────────────────────────────────────────
# "1" (default) = log peak favourable / adverse unrealised % + giveback/capture
# on close into cortex + trade raw_json (excursion scoreboard). Peaks always
# update live for mfe_giveback exits regardless of this flag.
# Rollback: MFE_TRACKING=0 (omit excursion fields on close logs only).
MFE_TRACKING=1

# ── HIF momentum range / confluence guard (Jul 23 gold lesson) ────────────────
# "1" = force on for all bots. "0" = force off.
# Unset = auto-on for gold only: bench rsi_momentum in range unless both metals
# oversold or GP agrees; otherwise probe-size until confluence. Never blocks GP.
# Rollback: MOM_RANGE_GUARD=0.
MOM_RANGE_GUARD=

# ── Regime split (MR in ranges, trend-follow in uptrends) ─────────────────────
# "1" = force on for all bots. "0" = force off.
# Unset = on for forex + gold + crypto. Chart "avoid" kills the wrong sleeve.
# Cost-aware: skips when ATR% is too small vs SCORECARD_COST_PCT.
# Rollback: REGIME_SPLIT=0.
REGIME_SPLIT=

# Forex focus pairs: force entry.session_filter=24h on volume at boot (fixes
# stuck london_only). Set 0 to leave volume sessions alone.
FOREX_SESSION_24H=1

# ── Soak controls ───────────────────────────────────────────────────────────
# HALT_ENTRIES=1 freezes NEW entries (exits + heartbeats continue).
# Recovery: unset/0 HALT_ENTRIES, or delete `{bot}/state/halt` / call clear_halt(bot).
HALT_ENTRIES=
# On process stop, if a halt file is present, force-close orphan paper positions
# into trades.jsonl (default off — open_book restore is preferred).
HALT_FLATTEN=
# L21 novel-regime pause (default on). Set 0 to log-only without blocking entries.
L21_FLATLINE=1
# Discovery: hourly pass throttle; re-invent even when formulas exist every N seconds (default 6h).
DISCOVERY_INTERVAL_S=3600
DISCOVERY_REINVENT_INTERVAL_S=21600
# Chronic invent timeout: shrink search after N, then skip invent for cooldown.
DISCOVERY_TIMEOUT_SHRINK_AFTER=2
DISCOVERY_TIMEOUT_SKIP_AFTER=4
DISCOVERY_TIMEOUT_COOLDOWN_S=3600
# Soft alert every N consecutive admit_zero invents (0=off).
DISCOVERY_ADMIT_ZERO_ALERT_AFTER=5
# Automated soak monitor (embedded in each bot + `python -m cron.soak_monitor`).
SOAK_MONITOR_NOTIFY=1
SOAK_MONITOR_INTERVAL_S=300
SOAK_WEEKLY_DIGEST_S=604800
SOAK_HB_ALERT_AGE_S=900
SOAK_PULSE_STALE_S=129600
SOAK_ADMIT_ZERO_ALERT=8
# GP lockout wall-clock unlock after N consecutive losses (default 6h).
# GP_LOCKOUT_DECAY_S=21600
# Cortex exile wall-clock reinstate (default 7d).
# EXILE_DECAY_S=604800
# Cap hypotheses_kb.jsonl lines (S10 full-file scan per invent candidate).
# HYPOTHESES_KB_MAX_LINES=5000
# HYPOTHESES_KB_KEEP_LINES=3000

# ── GP Brain promote + invent profiles ───────────────────────────────────────
# "1" = allow GP ensemble as real paper entries when the promote gate says so.
# Phase 0–3: MUST stay unset/0. Phase 4: enable only for gate-green pairs.
GP_PROMOTE=0
# Regime decay detector (Phase 5). "1" = 2-of-3 trip suppresses new entries.
REGIME_DECAY=0
REGIME_DECAY_MIN_TRADES=20
REGIME_DECAY_BREAKEVEN=0.45
REGIME_DECAY_WR_PROB=0.80
REGIME_DECAY_DD_MULT=1.5
REGIME_DECAY_OOD_Z=2.5
# Bayesian soft-weight min closed trades before non-passthrough (os.environ).
EXPERT_WEIGHT_MIN_N=15
# Comma list seeds initial per-pair bans in gp_promote_gate.json (cold start).
# Invent/shadow keep running on banned pairs; only promote entries are blocked.
# Gate auto ban/unban from paper/shadow expectancy (min samples + hysteresis +
# cooldown). Defaults: MIN_SAMPLES=30 BAN=-0.05 UNBAN=0.05 COOLDOWN_S=86400.
# BTC/USDT Focus: do NOT seed-ban BTC on the crypto bot (ignored if listed).
GP_EXCLUDE_PAIRS=GBP/JPY
# Binance-spot-like retail defaults for BTC CostModel (Phase 1). Percents, not bps.
# BTC_MAKER_FEE_PCT=0.1
# BTC_TAKER_FEE_PCT=0.1
# BTC_SLIPPAGE_FLOOR_BPS=1
# BTC_SLIPPAGE_ATR_K=0.05
# COST_STRESS_MULT=2.0
# GP_PROMOTE_GATE_MIN_SAMPLES=30
# GP_PROMOTE_GATE_BAN=-0.05
# GP_PROMOTE_GATE_UNBAN=0.05
# GP_PROMOTE_GATE_COOLDOWN_S=86400
# Island model / lexicase / MAP-Elites invent knobs (defaults match genetic.py).
GP_N_ISLANDS=1
GP_MIGRATE_EVERY=10
GP_LEXICASE_CASES=4
GP_MAP_ELITES=1
# Live feedback cadence (seconds) for online invent/shadow refresh.
LIVE_FEEDBACK_INTERVAL_S=
#
# Per-bot invent (TF + horizon + size + timeout) lives in bots/*/config.yaml
# under `invent:` — forex daily/h10, gold daily/h20, crypto 4h (BTC/USDT Focus).
# Invent TF must equal live GP eval TF.
